# Webhooks do Discord para avisos automáticos.
# Prefixo NEXT_PUBLIC_ é necessário porque esses valores são lidos no
# componente cliente (Dashboard.tsx) — sem esse prefixo o Next.js não
# expõe a variável para o browser.
NEXT_PUBLIC_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
NEXT_PUBLIC_DISCORD_STATS_WEBHOOK_URL="https://discord.com/api/webhooks/..."
NEXT_PUBLIC_DISCORD_ROOM_WEBHOOK_URL="https://discord.com/api/webhooks/..."
